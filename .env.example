# Copy to .env and fill in only what you actually have. The app runs fully
# with none of these set -- see README "Running with zero credentials".

# --- Database -----------------------------------------------------------
# Defaults to a local SQLite file (marketgen.db) if unset. Pointing this at a
# real Postgres/Supabase connection string activates the schema in
# migrations/postgres/*.sql (not exercised by this repo's app code directly --
# see README).
DATABASE_URL=sqlite:///./marketgen.db

# --- Content generation ---------------------------------------------------
# "stub" (default) = deterministic offline provider, zero credentials.
# "gemini" = use the Gemini adapter IF a key is present below; otherwise the
# app silently falls back to "stub" rather than failing.
CONTENT_PROVIDER=stub

# Only needed if CONTENT_PROVIDER=gemini. Get one from https://aistudio.google.com/
# Never commit a real value. Leave blank to keep the stub provider active.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Publishing -------------------------------------------------------
# Hard off-switch, checked in addition to the fact that no live adapter in
# this codebase has any implemented network call. See app/publishing/publisher.py.
ALLOW_LIVE_PUBLISHING=false

# --- Demo data ----------------------------------------------------------
SEED_DEMO_TENANTS=true
